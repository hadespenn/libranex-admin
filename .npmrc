# 依赖解析策略
#
# 背景：@ant-design/pro-components@3.x 的 peerDependencies 声明 antd ^6.0.0。
# 从 antd 5 升级时，node_modules 中已存在的旧版 antd 会被 npm 视作「已解析依赖」，
# 从而与新的 peer 约束冲突并抛出 ERESOLVE，导致 npm install 直接失败。
# legacy-peer-deps 让 npm 跳过该历史依赖树的 peer 校验，安装完成后
# （antd 6 + pro-components 3）依赖树本身是自洽的，不存在真实的版本冲突。
legacy-peer-deps=true

# pro-components 3.x 声明 engines.node >= 22.12，而本地为 Node 20。
# 该包运行时并不依赖 Node 22 特性，构建与运行均已验证通过，
# 此处关闭引擎严格校验以避免安装中断。
engine-strict=false
